# Supabase — safe public credentials protected by RLS
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server only — Supabase secret key. Never prefix with NEXT_PUBLIC_.
NEXT_PRIVATE_SUPABASE_SECRET_KEY=

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Never add Supabase secret/service-role keys to NEXT_PUBLIC_* variables.
